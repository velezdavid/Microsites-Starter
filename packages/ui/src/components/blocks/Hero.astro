---
import type { HeroBlock } from "../../types";
import { actionAttrs, splitHighlight } from "../../utils";
import Section from "../layout/Section.astro";

interface Props {
  block: HeroBlock;
}

const { block } = Astro.props;
const { variant = "landing", breadcrumb, eyebrow, title, titleHighlight, lead, text, actions = [], aside } = block;
const [before, highlighted, after] = splitHighlight(title, titleHighlight);
---

<Section {...block} flush>
  <div class={`hero hero--${variant}`}>
  {
    breadcrumb && breadcrumb.length > 0 && (
      <nav class="hero__crumbs" aria-label="Ruta">
        {breadcrumb.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {c.href ? (
              <a href={c.href}>{c.label}</a>
            ) : (
              <span class="hero__crumb-current" aria-current="page">
                {c.label}
              </span>
            )}
          </>
        ))}
      </nav>
    )
  }
  <div class="hero__row">
    <div class="hero__main">
      {eyebrow && <div class="hero__pill">{eyebrow}</div>}
      <h1 class="hero__title">
        {before}{highlighted && <span class="hero__highlight">{highlighted}</span>}{after}
      </h1>
      {lead && <p class="hero__lead">{lead}</p>}
      {text && <p class="hero__text">{text}</p>}
      {
        actions.length > 0 && (
          <div class="hero__actions">
            {actions.map((a) => (
              <a href={a.href} class:list={["ui-btn", `ui-btn--${a.style ?? "primary"}`]} {...actionAttrs(a.action)}>
                {a.label}
              </a>
            ))}
          </div>
        )
      }
    </div>

    {
      aside && (
        <div class="hero__aside">
          {aside.type === "stat" ? (
            <>
              <div class="ui-label">{aside.label}</div>
              <div class="hero__stat-value">{aside.value}</div>
              <div class="hero__stat-caption">{aside.caption}</div>
            </>
          ) : (
            <div data-tabs={aside.id}>
              <div class="hero__tabs-head">
                <span class="hero__tabs-title">{aside.title}</span>
                {aside.tabs.map((t, i) => (
                  <span data-tab-content={t.id} hidden={i > 0}>
                    {t.meta}
                  </span>
                ))}
              </div>
              <div
                role="tablist"
                aria-label={aside.ariaLabel}
                class="hero__tablist"
                style={`grid-template-columns:repeat(${aside.tabs.length},minmax(0,1fr))`}
              >
                {aside.tabs.map((t, i) => (
                  <button
                    type="button"
                    role="tab"
                    class="hero__tab"
                    id={`${aside.id}-tab-${t.id}`}
                    aria-controls={`${aside.id}-panel-${t.id}`}
                    aria-selected={i === 0 ? "true" : "false"}
                    tabindex={i === 0 ? 0 : -1}
                    data-tab={t.id}
                  >
                    {t.label}
                  </button>
                ))}
              </div>
              {aside.tabs.map((t, i) => (
                <div
                  role="tabpanel"
                  class="hero__stats"
                  id={`${aside.id}-panel-${t.id}`}
                  aria-labelledby={`${aside.id}-tab-${t.id}`}
                  data-tab-content={t.id}
                  hidden={i > 0}
                >
                  {t.stats.map((s, j) => (
                    <div class="hero__stat">
                      <div class:list={["hero__stat-num", { "hero__stat-num--accent": j === 0 }]}>{s.value}</div>
                      <div class="hero__stat-label">{s.label}</div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>
  </div>
</Section>

<style>
  .hero__row {
    display: flex;
    flex-wrap: wrap;
  }
  .hero__main {
    min-width: 0;
  }
  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-line);
    border-radius: 100px;
    padding: 8px 16px;
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.02;
    text-wrap: pretty;
  }
  .hero__highlight {
    color: var(--color-accent);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__aside {
    min-width: 0;
    background: linear-gradient(160deg, var(--color-surface), var(--color-surface-end));
    border: 1px solid var(--color-line);
    border-radius: 12px;
  }

  /* Landing variant (home) */
  .hero--landing {
    padding-block: clamp(48px, 9vw, 110px) clamp(48px, 8vw, 96px);
  }
  .hero--landing .hero__row {
    gap: clamp(36px, 6vw, 64px);
    align-items: center;
  }
  .hero--landing .hero__main {
    flex: 1.3 1 420px;
  }
  .hero--landing .hero__title {
    font-size: clamp(38px, 7vw, 68px);
    margin: 24px 0 0;
  }
  .hero--landing .hero__lead,
  .hero--landing .hero__text {
    font-size: clamp(17px, 2vw, 21px);
    line-height: 1.55;
    color: var(--color-muted);
    margin: 22px 0 0;
    max-width: 520px;
  }
  .hero--landing .hero__actions {
    margin-top: 34px;
  }
  .hero--landing .hero__aside {
    flex: 1 1 340px;
    padding: clamp(16px, 3vw, 26px);
  }

  /* Page variant (detail pages) */
  .hero--page {
    padding-block: clamp(40px, 7vw, 88px) clamp(48px, 8vw, 96px);
  }
  .hero--page .hero__row {
    gap: clamp(32px, 6vw, 64px);
    align-items: flex-end;
    margin-top: clamp(28px, 5vw, 44px);
  }
  .hero--page .hero__main {
    flex: 1.4 1 440px;
  }
  .hero--page .hero__pill {
    gap: 0;
  }
  .hero--page .hero__title {
    font-size: clamp(40px, 7vw, 72px);
    margin: 22px 0 0;
  }
  .hero--page .hero__lead {
    font-family: var(--font-display);
    font-size: clamp(21px, 3vw, 28px);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 20px 0 0;
    max-width: 640px;
    text-wrap: pretty;
  }
  .hero--page .hero__text {
    font-size: clamp(17px, 2vw, 19px);
    line-height: 1.6;
    color: var(--color-muted);
    margin: 16px 0 0;
    max-width: 600px;
    text-wrap: pretty;
  }
  .hero--page .hero__actions {
    margin-top: 32px;
  }
  .hero--page .hero__aside {
    flex: 1 1 300px;
    padding: clamp(22px, 4vw, 36px);
  }

  .hero__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-dim);
  }
  .hero__crumbs a {
    color: var(--color-muted);
  }
  .hero__crumbs a:hover {
    color: var(--color-text);
  }
  .hero__crumb-current {
    color: var(--color-accent);
  }

  /* Stat card aside */
  .hero__stat-value {
    font-family: var(--font-display);
    font-size: clamp(52px, 9vw, 84px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-accent);
    margin-top: 18px;
    overflow-wrap: anywhere;
  }
  .hero__stat-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--color-text);
    margin-top: 12px;
  }

  /* Stat tabs aside */
  .hero__tabs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-muted);
  }
  .hero__tabs-title {
    letter-spacing: 0.14em;
    color: var(--color-accent);
  }
  .hero__tablist {
    display: grid;
    gap: 4px;
    margin-top: 18px;
    padding: 4px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-line);
    border-radius: 6px;
  }
  .hero__tab {
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: clamp(11px, 2.8vw, 13px);
    min-height: 40px;
    padding: 0 2px;
    border-radius: 4px;
    background: transparent;
    color: var(--color-muted);
    transition: background 0.12s;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .hero__tab[aria-selected="true"] {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 10px;
  }
  .hero__stat {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: clamp(12px, 3vw, 18px);
    min-width: 0;
  }
  .hero__stat-num {
    font-family: var(--font-display);
    font-size: clamp(26px, 6vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .hero__stat-num--accent {
    color: var(--color-accent);
  }
  .hero__stat-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-top: 6px;
    line-height: 1.4;
  }
</style>
