---
import type { StepFlowBlock } from "../../types";
import { pad2 } from "../../utils";
import Section from "../layout/Section.astro";
import SectionHeading from "../layout/SectionHeading.astro";

interface Props {
  block: StepFlowBlock;
}

const { block } = Astro.props;
const { eyebrow, title, text, steps, note } = block;
---

<Section {...block}>
  <SectionHeading eyebrow={eyebrow} title={title} size="md" />
  {text && <p class="sf__text">{text}</p>}
  <ol class="sf__steps">
    {
      steps.map((s, i) => (
        <li class:list={["sf__step", { "sf__step--edge": i === 0 || i === steps.length - 1 }]}>
          <span class="sf__num">{pad2(i + 1)}</span>
          <span class="sf__title">{s}</span>
        </li>
      ))
    }
  </ol>
  {note && <p class="sf__note">{note}</p>}
</Section>

<style>
  .sf__text {
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-muted);
    margin: 16px 0 0;
    max-width: 640px;
  }
  .sf__steps {
    list-style: none;
    padding: 0;
    margin: clamp(28px, 5vw, 44px) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 8px;
  }
  .sf__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border-radius: 6px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    min-width: 0;
  }
  .sf__step--edge {
    border-color: var(--color-accent);
  }
  .sf__num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent);
  }
  .sf__title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
  }
  .sf__note {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    line-height: 1.6;
    margin: 20px 0 0;
  }
</style>
