---
import "../../styles/base.css";
import type { AnalyticsConfig, ExternalScript, Theme } from "../../types";
import { themeStyle } from "../../utils";
import ThirdPartyScripts from "./ThirdPartyScripts.astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  theme: Theme;
  analytics?: AnalyticsConfig;
  scripts?: ExternalScript[];
  canonical?: string;
  /** Absolute URL of the social sharing image. */
  image?: string;
  skipLabel?: string;
}

const { title, description, lang = "es", theme, analytics, scripts = [], canonical, image, skipLabel = "Saltar al contenido" } = Astro.props;
---

<!doctype html>
<html lang={lang} style={themeStyle(theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <ThirdPartyScripts analytics={analytics} scripts={scripts} position="head" />
    <slot name="head" />
  </head>
  <body>
    <ThirdPartyScripts analytics={analytics} position="body" />
    <a class="ui-skip-link" href="#main">{skipLabel}</a>
    <div class="ui-root">
      <slot />
    </div>
    <script>
      import "../../scripts/actions";
    </script>
  </body>
</html>
