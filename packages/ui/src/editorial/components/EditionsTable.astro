---
import type { EdEditionsTableBlock } from "../registry-types";
import MedalBadge from "./MedalBadge.astro";

type Props = Omit<EdEditionsTableBlock, "_type">;

const { columns, rows } = Astro.props;
---

<div class="et">
  <div class="et__grid et__thead" data-r="thead">
    {columns.map((c) => <span>{c}</span>)}
    <span></span>
  </div>
  {
    rows.map((e, i) => (
      <a href={e.href} class="et__grid et__row" data-r="tstack">
        <span class:list={["et__year", { "et__year--current": i === 0 }]}>{e.year}</span>
        <span class="et__winner">
          <MedalBadge level="grand" compact />
          {e.winner}
        </span>
        <span class="et__muted">{e.count}</span>
        <span class="et__muted">{e.date}</span>
        <span class="et__arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    ))
  }
</div>

<style>
  .et {
    display: flex;
    flex-direction: column;
  }
  .et__grid {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) 120px 120px 40px;
    gap: 12px;
  }
  .et__thead {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .et__row {
    align-items: center;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }
  .et__year {
    font-family: var(--font-display);
    font-size: 30px;
    line-height: 1;
  }
  .et__year--current {
    color: var(--accent);
  }
  .et__winner {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    flex-wrap: wrap;
  }
  .et__muted {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .et__arrow {
    font-family: var(--font-display);
    font-size: 18px;
    text-align: right;
  }
</style>
