---
import type { EdLatestEditionBlock } from "../registry-types";

type Props = Omit<EdLatestEditionBlock, "_type">;

const { eyebrow, status, year, detail, cta, top } = Astro.props;
---

<div class="le" data-r="stack">
  <div class="le__info">
    <span class="le__head">
      <span class="le__eyebrow">{eyebrow}</span>
      <span class="le__status">{status}</span>
    </span>
    <span class="le__year">{year}</span>
    <span class="le__detail">{detail}</span>
    <a class="ed-btn ed-btn--primary" href={cta.href}>{cta.label} ↗</a>
  </div>
  <div class="le__top">
    {
      top.map((t) => {
        const Tag = t.href ? "a" : "div";
        return (
          <Tag href={t.href} class="le__row">
            <span class="le__pos">{t.position}</span>
            <span class="le__text">
              <span class="le__name">{t.name}</span>
              <span class="le__sub">{t.detail}</span>
            </span>
          </Tag>
        );
      })
    }
  </div>
</div>

<style>
  .le {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    background: var(--sunken);
  }
  .le__info {
    padding: clamp(16px, 2.19vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .le__head {
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .le__eyebrow {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.24em;
    color: var(--accent-text);
    text-transform: uppercase;
  }
  .le__status {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    border: 1px solid var(--ink);
    padding: 2px 8px;
    text-transform: uppercase;
  }
  .le__year {
    font-family: var(--font-display);
    font-size: clamp(46px, 7.5vw, 96px);
    line-height: 0.85;
  }
  .le__detail {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .le__top {
    padding: clamp(16px, 2.19vw, 28px);
    display: flex;
    flex-direction: column;
    background: #fff;
    margin: 12px 12px 12px 0;
  }
  .le__row {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .le__pos {
    font-family: var(--font-display);
    font-size: clamp(22px, 3.44vw, 44px);
    line-height: 0.9;
    color: var(--accent);
  }
  .le__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .le__name {
    font-size: 16px;
    font-weight: 700;
  }
  .le__sub {
    font-size: 12px;
    color: var(--ink-muted);
  }
  @container ed (max-width: 960px) {
    .le__top {
      margin: 0 12px 12px;
    }
  }
</style>
