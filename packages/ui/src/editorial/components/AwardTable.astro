---
import type { EdAwardTableBlock } from "../registry-types";

type Props = Omit<EdAwardTableBlock, "_type">;

const { anchor, eyebrow, title, note, columns, filters, rows, footer } = Astro.props;
---

<section id={anchor} class="at" data-ed-filter>
  <div class="at__inner">
    <div class="at__head">
      <div class="ed-heading2">
        <span class="ed-heading2__eyebrow">{eyebrow}</span>
        <h2 class="ed-heading2__title">{title}</h2>
      </div>
      <span class="at__note">{note}</span>
    </div>
    <div class="at__chips" role="group" aria-label="Filtrar por categoría">
      {
        filters.map((f, i) => (
          <button type="button" class="ed-chip" data-filter={i === 0 ? "" : f} aria-pressed={i === 0 ? "true" : "false"}>
            {f}
          </button>
        ))
      }
    </div>
    <div class="at__table">
      <div class="at__grid at__thead" data-r="thead">
        {columns.map((c) => <span>{c}</span>)}
        <span></span>
      </div>
      {
        rows.map((r) => (
          <a href={r.href} class="at__grid at__row" data-r="tstack" data-filter-value={r.category}>
            <span class="at__name">{r.name}</span>
            <span class="at__type">{r.type}</span>
            <span class="at__text">{r.organizer}</span>
            <span class="at__strong">{r.edition}</span>
            <span class="at__strong">{r.winner}</span>
            <span class="at__arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
      {
        footer && (
          <div class="at__foot">
            <span>{footer.text}</span>
            <a class="ed-btn" href={footer.cta.href}>
              {footer.cta.label} ↗
            </a>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  // Chip filters: rows whose data-filter-value matches the pressed chip ("" = all).
  document.querySelectorAll<HTMLElement>("[data-ed-filter]").forEach((scope) => {
    const chips = scope.querySelectorAll<HTMLButtonElement>("button[data-filter]");
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.setAttribute("aria-pressed", String(c === chip)));
        const value = chip.dataset.filter ?? "";
        scope.querySelectorAll<HTMLElement>("[data-filter-value]").forEach((row) => {
          row.hidden = !!value && row.dataset.filterValue !== value;
        });
      }),
    );
  });
</script>

<style>
  .at {
    background: var(--sunken);
    margin-top: 80px;
    padding: 56px var(--gutter);
  }
  .at__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .at__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 12px;
    flex-wrap: wrap;
  }
  .at :global(.ed-heading2__title) {
    font-size: clamp(23px, 3.75vw, 48px);
  }
  .at__note {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .at__chips {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .at__table {
    background: #fff;
    display: flex;
    flex-direction: column;
  }
  .at__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) 150px minmax(0, 1fr) 120px minmax(0, 1fr) 24px;
    gap: 16px;
  }
  .at__thead {
    padding: 14px 24px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .at__row {
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--line);
  }
  .at__row[hidden] {
    display: none;
  }
  .at__name {
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .at__type {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.18em;
    color: var(--accent-text);
    text-transform: uppercase;
  }
  .at__text {
    font-size: 14px;
  }
  .at__strong {
    font-size: 14px;
    font-weight: 600;
  }
  .at__arrow {
    font-size: 16px;
    text-align: right;
  }
  .at__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 18px 24px;
    flex-wrap: wrap;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>
