---
import type { EdResultListBlock } from "../types";
import MedalBadge from "./MedalBadge.astro";

type Props = Omit<EdResultListBlock, "_type">;

const { title, items } = Astro.props;
---

<div class="rl">
  <span class="ed-label">{title}</span>
  {
    items.map((r) => (
      <a href={r.href} class="rl__item">
        <span class="rl__top">
          <span class="rl__award">{r.award}</span>
          <span class="rl__when">{r.when}</span>
        </span>
        <span class="rl__winner">
          <MedalBadge level={r.level} compact />
          <span class="rl__name">{r.winner}</span>
          {r.detail && <span class="rl__detail">{r.detail}</span>}
        </span>
      </a>
    ))
  }
</div>

<style>
  .rl {
    display: flex;
    flex-direction: column;
  }
  .rl__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .rl__top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .rl__award {
    font-family: var(--font-display);
    font-size: 24px;
    letter-spacing: 0.03em;
    line-height: 1;
    text-transform: uppercase;
  }
  .rl__when {
    font-size: 11px;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .rl__winner {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    flex-wrap: wrap;
  }
  .rl__name {
    font-weight: 600;
  }
  .rl__detail {
    color: var(--ink-muted);
  }
</style>
