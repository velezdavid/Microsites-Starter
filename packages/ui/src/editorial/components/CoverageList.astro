---
import type { EdCoverageListBlock } from "../registry-types";

type Props = Omit<EdCoverageListBlock, "_type">;

const { title, items, more } = Astro.props;
---

<div class="cv">
  <span class="ed-aside-title">{title}</span>
  {
    items.map((p) => (
      <a href={p.href} class="cv__item">
        <span class="cv__meta">
          {p.date} · {p.kind}
        </span>
        <span class="cv__title">{p.title}</span>
      </a>
    ))
  }
  {more && <a class="cv__more" href={more.href}>{more.label} ↗</a>}
</div>

<style>
  .cv {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cv__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .cv__meta {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .cv__title {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
  }
  .cv__more {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
