---
import type { EdEventListBlock } from "../types";

type Props = Omit<EdEventListBlock, "_type">;

const { items } = Astro.props;
---

<div class="el">
  {
    items.map((e) => (
      <a href={e.href} class="el__item">
        <span class="el__date">
          <span class="el__day">{e.day}</span>
          <span class="el__month">{e.month}</span>
        </span>
        <span class="el__text">
          <span class="el__name">{e.name}</span>
          <span class="el__place">{e.place}</span>
        </span>
      </a>
    ))
  }
</div>

<style>
  .el {
    display: flex;
    flex-direction: column;
  }
  .el__item {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .el__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid var(--ink);
    padding: 6px 0 4px;
  }
  .el__day {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1;
  }
  .el__month {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--accent-text);
    text-transform: uppercase;
  }
  .el__text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .el__name {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }
  .el__place {
    font-size: 12px;
    color: var(--ink-muted);
  }
</style>
