---
interface Props {
  tone?: "accent" | "ink" | "inverse";
  sponsored?: boolean;
}

const { tone = "accent", sponsored = false } = Astro.props;
---

{
  sponsored ? (
    <span class="sponsored">
      <slot>Patrocinado</slot>
    </span>
  ) : (
    <span class:list={["kicker", `kicker--${tone}`]}>
      <slot />
    </span>
  )
}

<style>
  .kicker {
    font-family: var(--font-display);
    font-size: var(--kicker-size);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--accent-text);
  }
  .kicker--ink {
    color: var(--ink);
  }
  .kicker--inverse {
    color: #fff;
  }
  .sponsored {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 7px;
    background: var(--premium);
    color: var(--deep);
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
