---
import type { EdAboutBoxBlock } from "../registry-types";

type Props = Omit<EdAboutBoxBlock, "_type">;

const { title, text, facts } = Astro.props;
---

<div class="ab2">
  <span class="ed-aside-title">{title}</span>
  {text && <p class="ab2__text">{text}</p>}
  <div class="ab2__facts">
    {
      facts.map((f) => (
        <div class="ab2__fact">
          <span class="ab2__label">{f.label}</span>
          <span class="ab2__value">{f.value}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .ab2 {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ab2__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
  }
  .ab2__facts {
    display: flex;
    flex-direction: column;
  }
  .ab2__fact {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    flex-wrap: wrap;
  }
  .ab2__label {
    color: var(--ink-muted);
  }
  .ab2__value {
    font-weight: 600;
    text-align: right;
  }
</style>
