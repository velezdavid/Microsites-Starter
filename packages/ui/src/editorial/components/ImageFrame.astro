---
import type { EdImage } from "../types";

interface Props {
  image?: EdImage;
  ratio?: string;
  /** Placeholder text when there is no photo. */
  label?: string;
  class?: string;
}

const { image, ratio = "3/2", label = "Imagen", class: className } = Astro.props;
const caption = image?.caption;
const credit = image?.credit;
---

<figure class:list={["frame", className]}>
  <div class="frame__box" style={`aspect-ratio:${ratio}`}>
    {
      image?.src ? (
        <img src={image.src} alt={image.alt ?? ""} loading="lazy" decoding="async" />
      ) : (
        <span class="frame__label" aria-hidden="true">{image?.label ?? label}</span>
      )
    }
  </div>
  {
    (caption || credit) && (
      <figcaption class="frame__caption">
        {caption}
        {credit && <span class="frame__credit"> · {credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .frame {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .frame__box {
    position: relative;
    width: 100%;
    background: var(--sunken);
    overflow: hidden;
  }
  .frame__box img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .frame__label {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 12px;
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .frame__caption {
    font-size: 12px;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .frame__credit {
    color: var(--ink-muted);
  }
</style>
