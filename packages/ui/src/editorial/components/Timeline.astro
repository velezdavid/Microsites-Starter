---
import type { EdTimelineBlock } from "../registry-types";

type Props = Omit<EdTimelineBlock, "_type">;

const { title, heading, steps, note } = Astro.props;
---

<div class="tl">
  <span class="ed-aside-title">{title}</span>
  <span class="tl__heading">{heading}</span>
  {
    steps.map((s) => (
      <div class="tl__step">
        <span class="tl__when">{s.when}</span>
        <span>{s.what}</span>
      </div>
    ))
  }
  {note && <span class="tl__note">{note}</span>}
</div>

<style>
  .tl {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .tl__heading {
    font-family: var(--font-display);
    font-size: clamp(22px, 3.44vw, 44px);
    line-height: 0.9;
  }
  .tl__step {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 10px;
    font-size: 13px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .tl__when {
    font-weight: 600;
  }
  .tl__note {
    font-size: 12px;
    color: var(--ink-muted);
  }
</style>
