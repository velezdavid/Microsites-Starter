---
import type { EdOpinionListBlock } from "../types";

type Props = Omit<EdOpinionListBlock, "_type">;

const { items } = Astro.props;
---

<div class="ol">
  {
    items.map((o) => (
      <a href={o.href} class="ol__item">
        <span class="ol__author">{o.author}</span>
        <span class="ol__title">{o.title}</span>
        <span class="ol__role">{o.role}</span>
      </a>
    ))
  }
</div>

<style>
  .ol {
    display: flex;
    flex-direction: column;
  }
  .ol__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  .ol__author {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .ol__title {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    text-wrap: pretty;
  }
  .ol__role {
    font-size: 12px;
    color: var(--ink-muted);
  }
</style>
