---
import type { EdAgendaBlock } from "../registry-types";
import Countdown from "./Countdown.astro";

type Props = Omit<EdAgendaBlock, "_type">;

const { title, views, typeLabel, types, cityLabel, cities, months, weekdays, events, empty, legend, prevLabel, nextLabel } = Astro.props;
const inMonth = (key: string) => events.filter((e) => e.date.startsWith(key));
---

<div class="ag2" data-ed-agenda data-view="list">
  <div class="ag2__head">
    <h2 class="ag2__title">{title}</h2>
    <div class="ag2__views" role="group" aria-label="Vista">
      <button type="button" class="ag2__view" data-view-btn="list" aria-pressed="true">{views[0]}</button>
      <button type="button" class="ag2__view" data-view-btn="month" aria-pressed="false">{views[1]}</button>
    </div>
  </div>

  <div class="ag2__filters">
    <div class="ag2__row" role="group" aria-label={typeLabel}>
      <span class="ag2__label">{typeLabel}</span>
      {
        types.map((t, i) => (
          <button type="button" class="ag2__chip" data-type={t.value} aria-pressed={i === 0 ? "true" : "false"}>
            {t.label}
          </button>
        ))
      }
    </div>
    <div class="ag2__row" role="group" aria-label={cityLabel}>
      <span class="ag2__label">{cityLabel}</span>
      {
        cities.map((c, i) => (
          <button type="button" class="ag2__chip" data-city={i === 0 ? "" : c} aria-pressed={i === 0 ? "true" : "false"}>
            {c}
          </button>
        ))
      }
    </div>
  </div>

  <div class="ag2__list" data-panel="list">
    {
      months.map((m) => (
        <div class="ag2__group" data-group>
          <span class="ag2__month">{m.label}</span>
          {inMonth(m.key).map((e) => {
            const Tag = e.href ? "a" : "div";
            return (
              <Tag href={e.href} class="ag2__event" data-r="table" data-ev data-type={e.type} data-city={e.city}>
                <span class="ag2__date">
                  <span class="ag2__day">{e.day}</span>
                  <span class="ag2__wd">{e.weekday}</span>
                </span>
                <span class="ag2__info">
                  <span class="ag2__type">{e.typeLabel}</span>
                  <span class="ag2__name">{e.name}</span>
                  <span class="ag2__org">{e.organizer}</span>
                </span>
                <span class="ag2__place">
                  <span class="ag2__city">{e.city}</span>
                  <span class="ag2__venue">{e.venue}</span>
                </span>
                <Countdown class="ag2__flag" date={e.countdown.date} fallback={e.countdown.fallback} />
              </Tag>
            );
          })}
        </div>
      ))
    }
    <p class="ag2__empty" hidden>{empty}</p>
  </div>

  <div class="ag2__cal" data-panel="month" hidden>
    {
      months.map((m, mi) => {
        const cells = Math.ceil((m.offset + m.days) / 7) * 7;
        return (
          <div class="ag2__calmonth" data-month={mi} hidden={mi > 0}>
            <div class="ag2__calnav">
              <button type="button" class="ag2__step" data-step="-1" disabled={mi === 0}>
                {prevLabel}
              </button>
              <span class="ag2__callabel">{m.label}</span>
              <button type="button" class="ag2__step" data-step="1" disabled={mi === months.length - 1}>
                {nextLabel}
              </button>
            </div>
            <div class="ag2__grid">
              {weekdays.map((w) => (
                <span class="ag2__wdh">{w}</span>
              ))}
              {Array.from({ length: cells }, (_, i) => {
                const d = i - m.offset + 1;
                const valid = d >= 1 && d <= m.days;
                const key = `${m.key}-${String(d).padStart(2, "0")}`;
                return (
                  <div class:list={["ag2__cell", { "ag2__cell--out": !valid }]}>
                    {valid && <span class="ag2__cellday">{d}</span>}
                    {valid &&
                      events
                        .filter((e) => e.date === key)
                        .map((e) => {
                          const Tag = e.href ? "a" : "div";
                          return (
                            <Tag href={e.href} class:list={["ag2__chipev", { "ag2__chipev--strong": e.strong }]} data-ev data-type={e.type} data-city={e.city}>
                              <span class="ag2__chipev-type">{e.typeLabel}</span>
                              <span class="ag2__chipev-name">{e.short}</span>
                            </Tag>
                          );
                        })}
                  </div>
                );
              })}
            </div>
            <div class="ag2__legend">
              <span><span class="ag2__key ag2__key--strong"></span>{legend[0]}</span>
              <span><span class="ag2__key"></span>{legend[1]}</span>
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ed-agenda]").forEach((box) => {
    const state = { type: "", city: "" };
    const apply = () => {
      box.querySelectorAll<HTMLElement>("[data-ev]").forEach((ev) => {
        ev.hidden = (!!state.type && ev.dataset.type !== state.type) || (!!state.city && ev.dataset.city !== state.city);
      });
      let any = false;
      box.querySelectorAll<HTMLElement>("[data-group]").forEach((g) => {
        const visible = [...g.querySelectorAll<HTMLElement>("[data-ev]")].some((e) => !e.hidden);
        g.hidden = !visible;
        any ||= visible;
      });
      box.querySelector<HTMLElement>(".ag2__empty")!.hidden = any;
    };
    const chips = (attr: "type" | "city") => {
      const buttons = box.querySelectorAll<HTMLButtonElement>(`.ag2__chip[data-${attr}]`);
      buttons.forEach((b) =>
        b.addEventListener("click", () => {
          buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
          state[attr] = b.dataset[attr] ?? "";
          apply();
        }),
      );
    };
    chips("type");
    chips("city");

    const viewButtons = box.querySelectorAll<HTMLButtonElement>("[data-view-btn]");
    viewButtons.forEach((b) =>
      b.addEventListener("click", () => {
        viewButtons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        box.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => (p.hidden = p.dataset.panel !== b.dataset.viewBtn));
      }),
    );

    const months = [...box.querySelectorAll<HTMLElement>("[data-month]")];
    box.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
      b.addEventListener("click", () => {
        const current = months.findIndex((m) => !m.hidden);
        const next = Math.min(months.length - 1, Math.max(0, current + Number(b.dataset.step)));
        months.forEach((m, i) => (m.hidden = i !== next));
      }),
    );
  });
</script>

<style>
  .ag2 {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .ag2__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
    flex-wrap: wrap;
  }
  .ag2__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(23px, 3.75vw, 48px);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .ag2__views {
    display: flex;
    flex-wrap: wrap;
  }
  .ag2__view {
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.16em;
    height: 36px;
    padding: 0 16px;
    border: 1px solid var(--ink);
    margin-left: -1px;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    text-transform: uppercase;
  }
  .ag2__view[aria-pressed="true"] {
    background: var(--ink);
    color: #fff;
  }
  .ag2__filters {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .ag2__row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
  }
  .ag2__label {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.24em;
    color: var(--ink-muted);
    width: 72px;
    text-transform: uppercase;
  }
  .ag2__chip {
    font-size: 12px;
    font-weight: 600;
    height: 34px;
    padding: 0 11px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }
  .ag2__chip[aria-pressed="true"] {
    border-color: var(--ink);
    background: var(--ink);
    color: #fff;
  }
  .ag2__list {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .ag2__list[hidden],
  .ag2__cal[hidden],
  .ag2__calmonth[hidden],
  .ag2__group[hidden],
  .ag2__event[hidden],
  .ag2__chipev[hidden] {
    display: none;
  }
  .ag2__group {
    display: flex;
    flex-direction: column;
  }
  .ag2__month {
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.24em;
    color: var(--ink-muted);
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    text-transform: uppercase;
  }
  .ag2__event {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr) 150px 120px;
    gap: 20px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .ag2__date {
    display: flex;
    flex-direction: column;
    line-height: 0.9;
  }
  .ag2__day {
    font-family: var(--font-display);
    font-size: clamp(22px, 3.44vw, 44px);
  }
  .ag2__wd {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .ag2__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .ag2__type {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.22em;
    color: var(--accent-text);
    text-transform: uppercase;
  }
  .ag2__name {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
  }
  .ag2__org,
  .ag2__venue {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .ag2__place {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 13px;
  }
  .ag2__city {
    font-weight: 600;
  }
  .ag2 :global(.ag2__flag) {
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-align: right;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .ag2 :global(.ag2__flag[data-soon="true"]) {
    color: var(--accent-text);
  }
  .ag2__empty {
    margin: 0;
    padding: 32px 0;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .ag2__calmonth {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .ag2__calnav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }
  .ag2__step {
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.16em;
    height: 34px;
    padding: 0 12px;
    white-space: nowrap;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    text-transform: uppercase;
  }
  .ag2__step:disabled {
    color: var(--ink-subtle);
    cursor: default;
  }
  .ag2__callabel {
    font-family: var(--font-display);
    font-size: 30px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ag2__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    border-top: 1px solid var(--ink);
    border-left: 1px solid var(--line);
  }
  .ag2__wdh {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
    padding: 8px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-transform: uppercase;
  }
  .ag2__cell {
    min-height: 104px;
    padding: 8px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #fff;
  }
  .ag2__cell--out {
    background: #fafafa;
  }
  .ag2__cellday {
    font-family: var(--font-display);
    font-size: 18px;
  }
  .ag2__chipev {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 4px 6px;
    background: var(--sunken);
    color: var(--ink);
  }
  .ag2__chipev--strong {
    background: var(--deep);
    color: #fff;
  }
  .ag2__chipev-type {
    font-family: var(--font-display);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .ag2__chipev-name {
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
  }
  .ag2__legend {
    display: flex;
    gap: 18px;
    font-size: 12px;
    color: var(--ink-muted);
    flex-wrap: wrap;
  }
  .ag2__legend > span {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .ag2__key {
    width: 10px;
    height: 10px;
    background: var(--sunken);
    border: 1px solid var(--line);
  }
  .ag2__key--strong {
    background: var(--deep);
    border: 0;
  }
  @container ed (max-width: 760px) {
    .ag2__grid {
      grid-template-columns: repeat(7, minmax(88px, 1fr));
      overflow-x: auto;
    }
  }
</style>
