---
import type { EdMentionsBlock } from "../types";

type Props = Omit<EdMentionsBlock, "_type">;

const { eyebrow, title, items } = Astro.props;
---

<section class="mn">
  <div class="mn__inner">
    <div class="mn__head">
      <span class="mn__eyebrow">{eyebrow}</span>
      <h2 class="mn__title">{title}</h2>
    </div>
    <div class="mn__grid">
      {
        items.map((c) => (
          <a href={c.href} class="mn__card">
            <span class="mn__top">
              <span class="mn__type">{c.type}</span>
              <span class="mn__ini" aria-hidden="true">{c.initials}</span>
            </span>
            <span class="mn__name">{c.name}</span>
            <span class="mn__detail">{c.detail}</span>
            <span class="mn__cta">{c.cta} ↗</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .mn {
    background: var(--sunken);
    margin-top: 72px;
    padding: 48px var(--gutter);
  }
  .mn__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .mn__head {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 10px;
  }
  .mn__eyebrow {
    font-family: var(--font-display);
    font-size: 14px;
    letter-spacing: 0.24em;
    color: var(--accent-text);
    text-transform: uppercase;
  }
  .mn__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(22px, 3.13vw, 40px);
    line-height: 0.9;
    text-transform: uppercase;
  }
  .mn__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(max(170px, calc(100% / 4 - 32px)), 1fr));
    gap: 24px;
  }
  .mn__card {
    background: #fff;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .mn__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mn__type {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.24em;
    color: var(--accent-text);
    text-transform: uppercase;
  }
  .mn__ini {
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--ink-muted);
  }
  .mn__name {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .mn__detail {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .mn__cta {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>
