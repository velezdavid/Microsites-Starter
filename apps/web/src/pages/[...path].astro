---
import type { GetStaticPaths } from "astro";
import SitePage from "../components/SitePage.astro";
import { isPreviewRequest } from "../lib/content/preview";
import { getSite } from "../lib/content/site";

// Public build: one static page per path. Preview site (rendered on demand): resolved per request.
export const getStaticPaths = (async () => {
  const site = await getSite();
  return site.pages.filter((p) => p.path !== "").map((page) => ({ params: { path: page.path } }));
}) satisfies GetStaticPaths;

const preview = isPreviewRequest(Astro.cookies);
const site = await getSite({ preview });
const path = decodeURIComponent(Astro.params.path ?? "");
const page = path ? site.pages.find((p) => p.path === path) : undefined;
if (!page) return new Response("Not found", { status: 404 });
---

<SitePage site={site} page={page} preview={preview} />
