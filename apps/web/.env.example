PUBLIC_SANITY_PROJECT_ID=dsappp92
PUBLIC_SANITY_DATASET=production
# Viewer token: only for visual editing with drafts (unpublished changes)
SANITY_API_READ_TOKEN=
# Visual editing in `astro dev` (Sanity Presentation). Never enable in Netlify.
SANITY_VISUAL_EDITING=
SANITY_STUDIO_URL=http://localhost:3333
# Only on the Netlify preview site (server-rendered, used by the Studio "Vista previa"). Never in public sites.
SANITY_PREVIEW_SITE=
SITE_SLUG=mediaudience
# Analytics (leave empty until the ids exist; GTM takes precedence over GA4)
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=
